class Phone:
    def turn_on(self):
        print("Phone is turning on")
class Computer:
    def turn_on(self):
        print("Computer is turning on")
class SmartWatch:
    def turn_on(self):
        print("SmartWatch is turning on")
def start_device(dev):
    dev.turn_on()
phone = Phone()
pc = Computer()
sw = SmartWatch()
start_device(phone)
start_device(pc)
start_device(sw)

